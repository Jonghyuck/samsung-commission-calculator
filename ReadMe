        window.addEventListener('online', () => updateSyncStatus('온라인 ☁️', '🟢'));
        window.addEventListener('offline', () => updateSyncStatus('오프라인', '🔴'));

        function updateSyncStatus(text, emoji) {
            document.getElementById('syncIcon').textContent = emoji;
            document.getElementById('syncText').textContent = text;
            document.getElementById('cloudStatus').textContent = text;
            document.getElementById('cloudStatus').innerHTML += ` ${emoji}`;
        }

        async function testSupabaseConnection() {
            try {
                const { data, error } = await supabase.from('commission_records').select('count').limit(1);
                if (!error) {
                    updateSyncStatus('클라우드 연결됨 ☁️', '🟢');
                    return true;
                }
            } catch (e) {
                updateSyncStatus('클라우드 연결 중...', '🟡');
            }
            return false;
        }

        // 탭 전환
        function showTab(tab) {
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById(tab).classList.add('active');
            event.target.classList.add('active');
            
            if (tab === 'status') loadCloudStatus();
            if (tab === 'history') loadAllHistory();
            if (tab === 'analysis') renderAnalysis();
        }

        // 미니 계산기
        function addMiniContract() {
            const id = miniContracts.length + 1;
            miniContracts.push({id, premium:0, converted:0, ratio:0});
            renderMiniContracts();
        }

        function renderMiniContracts() {
            let html = '';
            miniContracts.forEach((contract, i) => {
                html += `
                    <div class="mini-contract">
                        <h4>계약 ${contract.id}</h4>
